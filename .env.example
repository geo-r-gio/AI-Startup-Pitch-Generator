OPENAI_API_KEY=your_openai_api_key_here
LINKUP_API_KEY=your_linkup_api_key_here
GOOGLE_TRENDS_HL=en-US
GOOGLE_TRENDS_TZ=360
GOOGLE_TRENDS_GEO=US
GOOGLE_TRENDS_TIMEFRAME=today 12-m
GOOGLE_TRENDS_CONNECT_TIMEOUT=6
GOOGLE_TRENDS_READ_TIMEOUT=12
GOOGLE_TRENDS_RETRIES=2
GOOGLE_TRENDS_BACKOFF_FACTOR=0.4
GOOGLE_TRENDS_MAX_KEYWORDS=5
DISABLE_TRENDS=0
IMAGE_PROVIDER=auto
IMAGE_FETCH_ENABLED=1
IMAGE_REUSE_CACHE=1
OPENAI_IMAGE_ENABLED=0
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=low
